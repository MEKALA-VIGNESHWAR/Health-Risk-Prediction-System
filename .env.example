# ============================================
# PulseMind Platform — Environment Variables Reference
# Copy this file to .env or set environment variables in your environment/container.
# ============================================

# Server Configuration
PORT=8080
LOG_LEVEL=INFO

# PostgreSQL / Supabase Database Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.xtzkgzvmwwinktoghhqj
SPRING_DATASOURCE_PASSWORD=your_database_password_here
HIKARI_MAX_POOL=5

# Supabase REST API & Keys
SUPABASE_URL=https://xtzkgzvmwwinktoghhqj.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT & Authentication Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_here
JWT_EXPIRATION_MS=86400000

# OpenAI API Key (AI Assistant & Symptom Checker)
# If left blank, AI runs in graceful offline fallback mode
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Environment Variables (Vite)
VITE_API_BASE=/api
