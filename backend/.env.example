# ============================================
# PulseMind Backend Environment Variables
# Copy to backend/.env or configure in application environment.
# ============================================

PORT=8080
LOG_LEVEL=INFO

# Database Connection (PostgreSQL / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.xtzkgzvmwwinktoghhqj
SPRING_DATASOURCE_PASSWORD=your_database_password_here
HIKARI_MAX_POOL=5

# Supabase REST API
SUPABASE_URL=https://xtzkgzvmwwinktoghhqj.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI API (AI assistant features)
OPENAI_API_KEY=your_openai_api_key
